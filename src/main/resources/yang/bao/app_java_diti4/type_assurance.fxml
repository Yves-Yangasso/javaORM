<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefWidth="450.0" prefHeight="380.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="yang.bao.app_java_diti4.controllers.TypeAssuranceController">

    <children>

        <!-- Titre -->
        <Text layoutX="20" layoutY="35" text="Gestion des Types d’Assurance">
            <font>
                <Font size="18"/>
            </font>
        </Text>

        <!-- Formulaire -->
        <VBox layoutX="20" layoutY="60" spacing="15">
            <children>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Libellé :" prefWidth="80"/>
                    <TextField fx:id="tfLabel"
                               prefWidth="300"
                               promptText="Ex: Auto, Santé, Habitation"/>
                </HBox>

                <HBox spacing="10">
                    <Button fx:id="btnAjouter"
                            text="Ajouter"
                            onAction="#handleAjouter"
                            style="-fx-background-color:#4CAF50; -fx-text-fill:white;"
                            prefWidth="100"/>

                    <Button fx:id="btnModifier"
                            text="Modifier"
                            onAction="#handleModifier"
                            style="-fx-background-color:#2196F3; -fx-text-fill:white;"
                            prefWidth="100"/>

                    <Button fx:id="btnSupprimer"
                            text="Supprimer"
                            onAction="#handleSupprimer"
                            style="-fx-background-color:#f44336; -fx-text-fill:white;"
                            prefWidth="100"/>

                    <Button fx:id="btnEffacer"
                            text="Effacer"
                            onAction="#handleEffacer"
                            style="-fx-background-color:#FF9800; -fx-text-fill:white;"
                            prefWidth="100"/>
                </HBox>

            </children>
        </VBox>

        <!-- Table -->
        <TableView fx:id="tableType"
                   layoutX="20"
                   layoutY="160"
                   prefWidth="410"
                   prefHeight="190">

            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colLabel" text="Libellé" prefWidth="310"/>
            </columns>

        </TableView>

    </children>

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

</AnchorPane>
